# LOCAL DEVELOPMENT ONLY. Browser/API are same-origin through the web proxy.
NODE_ENV=development
HUB_HOST=127.0.0.1
PORT=4311
PUBLIC_ORIGIN=http://127.0.0.1:3000
HUB_EMBEDDED_DB=true
HUB_DATA_DIR=.data/postgres
HUB_LOCAL_OWNER_LOGIN=true
HUB_LOCAL_OWNER_HANDLE=local-owner

# PRODUCTION: replace local settings; never commit credentials.
# NODE_ENV=production
# PUBLIC_ORIGIN=https://your-hub.example
# DATABASE_URL=postgresql://...
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...
# HUB_LOCAL_OWNER_LOGIN=false
# HUB_EMBEDDED_DB=false

# Private beta is invite-only. Replace examples with approved stable numeric GitHub IDs.
# HUB_PRIVATE_BETA=true
# HUB_BETA_ALLOWED_GITHUB_IDS=123456
# HUB_BETA_INTERNAL_GITHUB_IDS=
# HUB_BETA_TEST_GITHUB_IDS=
# HUB_BETA_COHORT=private-beta-1
# HUB_WEEKLY_RESEARCH_ENABLED=false
