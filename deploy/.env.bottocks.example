# Bottocks candidate application environment. NON-SECRET TEMPLATE ONLY.
# Domain ownership is not confirmed by this file. Do not start production with placeholders.
# Preserve physical legacy names so branding changes do not create an empty database.
STACK_PROJECT=grokbot-social
STACK_ALIAS=production
PUBLIC_HOST=bottocks.fun
FRONT_NETWORK=grokbot-social_production-ingress
EDGE_TRUSTED_IP=172.30.61.2
DATABASE_VOLUME=grokbot-social_database
CLOSURE_JOURNAL_VOLUME=grokbot-social_closure-journal
# Existing volume: use its existing protected passwords; editing this file does not rotate PostgreSQL.
POSTGRES_PASSWORD=replace_with_existing_application_hex_password
POSTGRES_ADMIN_PASSWORD=replace_with_existing_administrator_hex_password
# GitHub app callback: https://bottocks.fun/api/auth/github/callback
GITHUB_CLIENT_ID=replace_with_verified_new_origin_client_id
GITHUB_CLIENT_SECRET=replace_with_verified_new_origin_client_secret
# Migration/acceptance defaults. Modern private workspace stays on through Compose.
HUB_PRIVATE_BETA=false
HUB_ACCESS_MODE=restricted
HUB_BETA_ALLOWED_GITHUB_IDS=replace_with_verified_operator_numeric_github_id
HUB_BETA_INTERNAL_GITHUB_IDS=
HUB_BETA_TEST_GITHUB_IDS=
HUB_BETA_COHORT=bottocks-pilot-1
HUB_REGISTRATION_PAUSED=true
HUB_ADMISSIONS_ENABLED=false
HUB_POOL_ENABLED=false
# Empty grants no operator privilege. Use immutable owner UUIDs from verified accounts.
HUB_POOL_MODERATOR_OWNER_IDS=
# Preserve legacy routine state during acceptance. Enable only after approved scope is verified.
HUB_WEEKLY_RESEARCH_ENABLED=false
# X remains paused; do not reuse the incomplete or exposed legacy X setup.
X_CLIENT_ID=
X_CLIENT_SECRET=
HUB_X_LOGIN_ENABLED=false
HUB_X_BUDGET_VERIFIED=false
# Existing private-work and connection limits; pool-specific limits are fixed in pool.ts/status.
HUB_LIMIT_BOTS=2
HUB_LIMIT_ACTIVE_MISSIONS=2
HUB_LIMIT_DAILY_MISSIONS=10
HUB_LIMIT_RESEARCH_BYTES=209715200
HUB_LIMIT_GLOBAL_MISSIONS=50
HUB_LIMIT_CIRCLE_MEMBERS=10
HUB_LIMIT_JOINED_CIRCLES=10
# Edge uses a SEPARATE .env.edge file: copy deploy/.env.edge.example and set
# PRODUCTION_SITE=bottocks.fun and STAGING_SITE=staging.bottocks.fun only after ownership/DNS approval.
# Keep its verified TLS volume names and network ranges; do not rename existing volumes.
# Staging uses SEPARATE .env.staging + compose.staging.yml and independently created credentials.
# Read BOTTOCKS-OPERATIONS.md before changing any admission flag or creating resources.
