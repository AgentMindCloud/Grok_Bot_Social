# Copy to deploy/.env ON THE DEPLOYMENT HOST. Never commit real values.
# Choose a host you control, with DNS pointing to this server.
PUBLIC_HOST=hub.example.com
# Use at least 32 random hexadecimal characters (URL-safe in DATABASE_URL).
POSTGRES_PASSWORD=replace_with_a_random_hexadecimal_password
# A DIFFERENT password for database administration; not given to the hub.
POSTGRES_ADMIN_PASSWORD=replace_with_a_separate_administrator_password
# OAuth callback: https://<PUBLIC_HOST>/api/auth/github/callback
GITHUB_CLIENT_ID=replace_with_oauth_client_id
GITHUB_CLIENT_SECRET=replace_with_oauth_client_secret
