# Production only. Create mode 600 on the host; never copy real values to staging.
STACK_PROJECT=grokbot-social
STACK_ALIAS=production
PUBLIC_HOST=grokbotsocial.com
FRONT_NETWORK=grokbot-social_production-ingress
EDGE_TRUSTED_IP=172.30.61.2
# Verify this exact existing volume before cutover. external:true refuses a new one.
DATABASE_VOLUME=grokbot-social_database
# Create this new, separate journal volume once; retain it through DB restores.
CLOSURE_JOURNAL_VOLUME=grokbot-social_closure-journal
POSTGRES_PASSWORD=replace_with_random_application_hex_password
POSTGRES_ADMIN_PASSWORD=replace_with_different_administrator_hex_password
GITHUB_CLIENT_ID=replace_with_production_github_client_id
GITHUB_CLIENT_SECRET=replace_with_production_github_secret
# Keep the operator access list during migration, then set open/false/true only
# after real authentication, native connections, privacy and backup checks pass.
HUB_ACCESS_MODE=restricted
HUB_PRIVATE_BETA=false
HUB_BETA_ALLOWED_GITHUB_IDS=replace_with_operator_numeric_github_ids
HUB_BETA_INTERNAL_GITHUB_IDS=
HUB_BETA_TEST_GITHUB_IDS=
HUB_BETA_COHORT=open-beta-1
HUB_REGISTRATION_PAUSED=true
HUB_ADMISSIONS_ENABLED=false
HUB_WEEKLY_RESEARCH_ENABLED=true
# X stays off until actual app pricing, $10 cap and disabled recharge are verified.
X_CLIENT_ID=
X_CLIENT_SECRET=
HUB_X_LOGIN_ENABLED=false
HUB_X_BUDGET_VERIFIED=false
# Explicit service limits are optional; defaults implement the approved launch.
HUB_LIMIT_BOTS=2
HUB_LIMIT_ACTIVE_MISSIONS=2
HUB_LIMIT_DAILY_MISSIONS=10
HUB_LIMIT_RESEARCH_BYTES=209715200
HUB_LIMIT_GLOBAL_MISSIONS=50
HUB_LIMIT_CIRCLE_MEMBERS=10
HUB_LIMIT_JOINED_CIRCLES=10
